var (
	rowsCallRe       = regexp.MustCompile(`\brows\(\s*"([^"]+)"\s*\)`)
	hasDatasetCallRe = regexp.MustCompile(`\bhas_dataset\(\s*"([^"]+)"\s*\)`)
	paramCallRe      = regexp.MustCompile(`\bparam\(\s*"([^"]+)"\s*\)`)
)

func extractExpressionReferences(expression string) expressionReferences {
	requiredDatasets := literalArgs(expression, rowsCallRe)
	datasets := append([]string{}, requiredDatasets...)
	datasets = append(datasets, literalArgs(expression, hasDatasetCallRe)...)
	params := literalArgs(expression, paramCallRe)
	return expressionReferences{
		Datasets:         normalizeStringSet(datasets),
		RequiredDatasets: normalizeStringSet(requiredDatasets),
		Params:           normalizeStringSet(params),
	}
}

func resolveExpressionDatasets(required []string, input map[string]DatasetInput) (map[string][]any, EvaluateResult, bool) {
	out := make(map[string][]any, len(input))
	for dataset, entry := range input {
		if entry.Error != nil {
			continue
		}
		out[dataset] = entry.Rows
	}

	for _, dataset := range required {
		entry, ok := input[dataset]
		if !ok {
			return nil, EvaluateResult{Status: EvaluateStatus_UNKNOWN, ReasonCode: "dataset_missing_dataset"}, false
		}
		if entry.Error != nil {
			return nil, EvaluateResult{Status: EvaluateStatus_UNKNOWN, ReasonCode: "dataset_" + string(entry.Error.Kind)}, false
		}
		out[dataset] = entry.Rows
	}
	return out, EvaluateResult{}, true
}

