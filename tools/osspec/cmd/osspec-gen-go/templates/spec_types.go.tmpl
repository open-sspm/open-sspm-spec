		return EvaluateResult{Status: EvaluateStatus_UNKNOWN, ReasonCode: "invalid_plan_expect"}, fmt.Errorf("check.plan.expect.on_empty must be fail|unknown")
	}
	if match != "all" && match != "any" {
		return EvaluateResult{Status: EvaluateStatus_UNKNOWN, ReasonCode: "invalid_plan_expect"}, fmt.Errorf("check.plan.expect.match must be all|any")
	}

	selectedCount := len(selected)
	if selectedCount == 0 {
		if onEmpty == "unknown" {
			return EvaluateResult{Status: EvaluateStatus_UNKNOWN, ReasonCode: "empty_selection"}, nil
		}
		return EvaluateResult{Status: EvaluateStatus_FAIL, ReasonCode: "empty_selection", SelectedCount: 0, PassedCount: 0, CountValue: 0}, nil
	}
	if selectedCount < minSelected {
		target := minSelected
		return EvaluateResult{
			Status:        EvaluateStatus_FAIL,
			ReasonCode:    "min_selected_not_met",
			SelectedCount: selectedCount,
			PassedCount:   0,
			CountValue:    selectedCount,
			TargetValue:   &target,
		}, nil
