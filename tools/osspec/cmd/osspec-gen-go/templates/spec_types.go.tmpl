	for _, row := range selected {
		ok, err := evaluateCELPredicate(assertExpr, row, params)
		if err != nil {
			return EvaluateResult{Status: EvaluateStatus_UNKNOWN, ReasonCode: "cel_error"}, err
		}
		if ok {
			passed++
		}
