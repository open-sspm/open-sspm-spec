	switch kind {
	case DatasetErrorKind_PERMISSION_DENIED:
		return strings.ToLower(strings.TrimSpace(plan.OnPermissionDenied))
	case DatasetErrorKind_SYNC_FAILED, DatasetErrorKind_ENGINE_ERROR:
		return strings.ToLower(strings.TrimSpace(plan.OnSyncError))
	default:
		return strings.ToLower(strings.TrimSpace(plan.OnMissingDataset))
	}
}

